<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        id="cordova-plugin-batterycheck"
        version="1.0.0">

    <name>BatteryCheck</name>
    <description>Reads the current battery level and charging state of the device, once, on demand.</description>
    <license>MIT</license>
    <keywords>cordova, battery, status, charging</keywords>
    <repo>https://github.com/mbamado/cordova-plugin-batterycheck.git</repo>
    <issue>https://github.com/mbamado/cordova-plugin-batterycheck/issues</issue>

    <js-module src="www/batterycheck.js" name="BatteryCheck">
        <clobbers target="cordova.plugins.BatteryCheck" />
    </js-module>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="BatteryCheck">
                <param name="android-package" value="com.outsystems.batterycheck.BatteryCheck" />
            </feature>
        </config-file>

        <source-file src="src/android/BatteryCheck.java" target-dir="src/com/outsystems/batterycheck" />
    </platform>
</plugin>
